{
  "name": "@argus/argus",
  "version": "0.1.0",
  "private": true,
  "description": "Supply-chain radar: tracks what's trending and whether it's safe to install, right now. Codename Argus.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "cli": "node apps/cli/argus.ts",
    "scan": "node apps/cli/argus.ts scan",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "test:e2e": "node --test \"tests/e2e/*.test.ts\"",
    "record": "node scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0"
  }
}
